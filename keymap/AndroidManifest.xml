<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ua.pc.keymap">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30"/>
    <queries>
        <package android:name="ua.kyivstar.tv.androidtv"/>
        <package android:name="com.kyivstar.tv.androidtv"/>
        <package android:name="com.megogo.application"/>
    </queries>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <application android:label="Key Launcher" android:allowBackup="false">
        <service android:name=".KeyService"
            android:exported="true"
            android:label="Key Launcher"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/service"/>
        </service>
    </application>
</manifest>
